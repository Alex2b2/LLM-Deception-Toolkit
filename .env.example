# Copy to .env and fill in. Never commit .env.

MONGO_URI=mongodb://localhost:27017/
DB_NAME=llm_deception

# Base URL that canary files point back to. Must be reachable by the agents you monitor.
CANARY_BASE_URL=http://127.0.0.1:5000
CANARY_COUNT=5

HONEYPOT_MAX_REQUESTS=5
HONEYPOT_TIME_WINDOW=30

# IP reputation enrichment (optional, each one free to sign up for)
ABUSEIPDB_API_KEY=
ABUSEIPDB_MIN_SCORE=50
ABUSECH_AUTH_KEY=
OTX_API_KEY=
OTX_MIN_PULSES=1
ENRICH_CACHE_HOURS=24

# IOC feeds (/feeds/stix.json, /feeds/misp/manifest.json, /feeds/iocs.csv)
FEED_TOKEN=
FEED_DAYS=30
FEED_INCLUDE_PRIVATE=false
ORG_NAME=LLM Deception Toolkit

# Optional Slack alerts
SLACK_TOKEN=
SLACK_CHANNEL=

# Dashboard protection (required if HOST is not 127.0.0.1)
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=
SECRET_KEY=

HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=false
# Set to 1 if running behind one reverse proxy, so client IPs are correct
TRUSTED_PROXIES=0
